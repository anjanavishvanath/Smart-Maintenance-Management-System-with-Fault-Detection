# PreSense — root .env (loaded automatically by docker-compose).
# Copy this file to `.env` in the same directory as docker-compose.yml and fill in values.
# DO NOT commit the real .env file.

# --- Database ---
POSTGRES_USER=cm_user
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=cm_db

